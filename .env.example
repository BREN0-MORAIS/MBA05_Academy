# ===========================================
# AcademyIO - Variaveis de Ambiente
# ===========================================
# Copie este arquivo para .env e configure os valores
# NUNCA commite o arquivo .env com credenciais reais!
# ===========================================

# Ambiente (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# ===========================================
# JWT - Autenticacao
# ===========================================
# IMPORTANTE: Em producao, use uma chave segura gerada aleatoriamente
# Exemplo: openssl rand -base64 64
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres
JWT_ISSUER=AcademyIO
JWT_VALID_IN_HOURS=1

# ===========================================
# RabbitMQ - Mensageria
# ===========================================
RABBITMQ_HOST=rabbit
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# String de conexao completa (usada nos servicos)
# Formato: host=<host>;username=<user>;password=<pass>;publisherConfirms=true;timeout=10
MESSAGEBUS_CONNECTION=host=rabbit;username=guest;password=guest;publisherConfirms=true;timeout=10

# ===========================================
# Banco de Dados
# ===========================================
# SQLite (Desenvolvimento)
# DATABASE_PROVIDER=SQLite

# PostgreSQL (Producao - recomendado)
# DATABASE_PROVIDER=PostgreSQL
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=academyio
# DATABASE_USER=postgres
# DATABASE_PASSWORD=sua-senha-segura

# SQL Server (Producao - alternativa)
# DATABASE_PROVIDER=SqlServer
# DATABASE_HOST=localhost
# DATABASE_PORT=1433
# DATABASE_NAME=academyio
# DATABASE_USER=sa
# DATABASE_PASSWORD=sua-senha-segura

# ===========================================
# URLs dos Servicos (usadas pelo BFF)
# ===========================================
AUTH_SERVICE_URL=http://auth:8080
COURSE_SERVICE_URL=http://courses:8080
STUDENT_SERVICE_URL=http://students:8080
PAYMENT_SERVICE_URL=http://payments:8080

# ===========================================
# Portas Externas (Docker)
# ===========================================
AUTH_PORT=5001
COURSES_PORT=5002
PAYMENTS_PORT=5003
STUDENTS_PORT=5004
BFF_PORT=5000
RABBITMQ_PORT_AMQP=5672
RABBITMQ_PORT_MANAGEMENT=15672

# ===========================================
# Logging
# ===========================================
# Niveis: Verbose, Debug, Information, Warning, Error, Fatal
LOG_LEVEL=Information
SEQ_URL=http://localhost:5341

# ===========================================
# Observabilidade (opcional)
# ===========================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=academyio

# ===========================================
# Redis Cache (opcional)
# ===========================================
# REDIS_CONNECTION=localhost:6379
# REDIS_PASSWORD=

# ===========================================
# CORS (Frontend)
# ===========================================
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ===========================================
# Rate Limiting (opcional)
# ===========================================
# RATE_LIMIT_REQUESTS_PER_MINUTE=100
# RATE_LIMIT_REQUESTS_PER_HOUR=1000
